# GEMINI_API_KEY: Required for Gemini AI API calls (Script Parser LLM / Fallback).
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# TELEGRAM_BOT_TOKEN: Bot token from @BotFather for Telegram interface (optional in local web mode)
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_ALLOWED_USERS: Whitelist of allowed Telegram user IDs separated by commas (e.g. "12345678,87654321"). Leave empty to allow any user.
TELEGRAM_ALLOWED_USERS=""

# TTS_DEFAULT_VOICE: Default Vietnamese voice ID for Edge-TTS / Local TTS
TTS_DEFAULT_VOICE="vi-VN-NamMinhNeural"

# RENDER_FPS: Frame rate for 9:16 stickman animation rendering
RENDER_FPS="30"

# RENDER_RESOLUTION: Target vertical video resolution (widthxheight)
RENDER_RESOLUTION="1080x1920"

# FFMPEG_PATH / FFPROBE_PATH: Path to FFmpeg & FFprobe portable binaries
FFMPEG_PATH="C:\\ffmpeg\\bin\\ffmpeg.exe"
FFPROBE_PATH="C:\\ffmpeg\\bin\\ffprobe.exe"

